# Copy to .env at the repo root (optional). Dev defaults only — no secrets.
# Export inline instead: INGESTION_ENABLED=true OPENF1_SESSION_KEY=9161 ./mvnw spring-boot:run -pl f1-api

# OpenF1 ingestion (required for live car positions)
INGESTION_ENABLED=true
OPENF1_SESSION_KEY=9161
# Optional authenticated OpenF1 access during live sessions
# OPENF1_ACCESS_TOKEN=
# OPENF1_USERNAME=
# OPENF1_PASSWORD=

# Postgres — host port 5433 per docker-compose.yml (5433:5432)
DB_URL=jdbc:postgresql://localhost:5433/f1
DB_USER=f1user
DB_PASSWORD=f1pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# API
SERVER_PORT=8080

# Dev admin login (matches application.yml defaults)
# ADMIN_USER=admin
# ADMIN_PASSWORD=changeme

# Optional AI insights
# AI_ENABLED=false
# OPENAI_API_KEY=

# --- Production (SPRING_PROFILES_ACTIVE=prod) — all required unless noted ---
# SPRING_PROFILES_ACTIVE=prod
# JWT_SECRET=                          # required; min 32 chars, not CHANGE_ME placeholder
# ADMIN_PASSWORD=                        # required; must not be "changeme"
# WEBSOCKET_ALLOWED_ORIGINS=           # required; comma-separated, e.g. https://app.example.com
# APP_CORS_ORIGINS=                    # optional; set when frontend is on a different domain
# INGESTION_ENABLED=false              # default in prod; set true to poll OpenF1
# OPENAI_API_KEY=                        # required only when AI_ENABLED=true
