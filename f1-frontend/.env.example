# Copy to .env and adjust. All VITE_* vars are baked in at build time.

# OpenF1 session key — must match backend OPENF1_SESSION_KEY
VITE_SESSION_KEY=9161

# STOMP/SockJS WebSocket endpoint (default works with local API on :8080)
# VITE_WS_URL=http://localhost:8080/ws

# REST base URL — leave unset in dev (Vite proxies /api → localhost:8080)
# Set for production builds, e.g. VITE_API_URL=https://api.example.com
# VITE_API_URL=

# Dev JWT auto-login for protected routes (e.g. AI insight feed)
# VITE_DEV_AUTOLOGIN=true
# VITE_DEV_AUTH_USER=admin
# VITE_DEV_AUTH_PASS=changeme
